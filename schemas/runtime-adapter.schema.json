{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "captain-runtime-adapter.schema.json",
  "title": "Captain OS runtime adapters",
  "type": "object",
  "required": ["schemaVersion", "adapters"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "captain-runtime-adapters.v1" },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runtimeId", "ownerRegistryId", "instructionEntrypoint", "captainEligibility", "defaultRole", "swarmRole", "captainOsHooks"],
        "additionalProperties": true,
        "properties": {
          "runtimeId": { "type": "string", "minLength": 1 },
          "ownerRegistryId": { "type": "string", "minLength": 1 },
          "instructionEntrypoint": { "enum": ["AGENTS.md", "CLAUDE.md", "GEMINI.md"] },
          "captainEligibility": { "enum": ["primary", "secondary", "dynamic", "crew_only", "disabled"] },
          "defaultRole": { "enum": ["captain", "captain_first", "read_only_judge", "worker"] },
          "swarmRole": { "enum": ["orchestrator_and_integrator", "standing_review_lane", "optional_judge_or_packeted_lane", "packet_worker"] },
          "captainOsHooks": {
            "type": "object",
            "required": ["agentLaneLifecycle", "nativeGoal", "persistentLaneReuse", "typedEvidence"],
            "additionalProperties": { "enum": ["supported", "manual", "handoff_required"] }
          },
          "launcher": {
            "type": "object",
            "required": ["transport", "receiptSchema"],
            "properties": {
              "transport": { "enum": ["process_cli", "host_native_receipt"] },
              "executable": { "type": "string" },
              "receiptSchema": { "const": "captain-worker-receipt.v1" },
              "missingCapabilityBehavior": { "enum": ["handoff", "block_claim"] }
            }
          }
        }
      }
    }
  }
}
